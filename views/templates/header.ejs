<%
    const navLinks = loggedIn
        ? [{ href: "/", label: "HOME" }, { href: "/dashboard", label: "DASHBOARD" }, { href: "/leaderboard", label: "LEADERBOARD" }, { href: "/logout", label: "SIGN OUT" }]
        : [{ href: "/", label: "HOME" }, { href: "/leaderboard", label: "LEADERBOARD" }, { href: "/login", label: "LOG IN" }, { href: "/signup", label: "SIGN UP" }];
    const linkClass = (href) => currentPath === href ? "link-highlighted" : "";
%>
<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CIVIL PROTECTION MEDIA</title>

    <!--Inline so the first paint is already dark, before style.css downloads (no white flash)-->
    <style>html { background-color: #072734; }</style>

    <!--Google Fonts: Orbitron is the default page font (set on * in style.css)-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap">

    <!--Style sheets-->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/animations.css">

    <!--Javascript-->
    <script src="/js/combine.js"></script>
    <% if (typeof scripts !== "undefined") { %>
        <% scripts.forEach(src => { %>
            <script src="<%= src %>"></script>
        <% }) %>
    <% } %>
</head>

<body class="fabricator-background">
    <nav class="nav">
        <ul class="fabricator-background">
            <li class="logo">
                <a href="/" style="padding: 0;">
                    <svg class="nav-logo" version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 749 242"><rect x="8.669" y="8.845" width="224.808" height="98.783"/><rect x="8.375" y="114.292" width="41.94" height="42.728"/><polygon points="8.474,234.244 234.263,234.244 162.918,164.075 8.474,164.075 "/><polygon points="332.653,78.622 262.487,9.238 262.487,234.244 332.653,234.244 "/><rect x="340.102" y="64.9" width="97.999" height="99.175"/><rect x="516.106" y="9.041" width="84.279" height="225.201"/><polygon points="446.332,50.005 487.1,8.845 487.1,234.24 445.94,234.24 "/><rect x="608.615" y="65.293" width="132.886" height="42.728"/><rect x="699.56" y="114.684" width="41.94" height="42.335"/><polygon points="608.226,234.146 741.5,234.146 741.5,164.075 677.609,164.075 "/></svg>
                </a>
            </li>
            <div class="nav-links">
                <% navLinks.forEach(link => { %>
                    <li class="desktop-only"><a class="<%= linkClass(link.href) %>" href="<%= link.href %>" data-text="<%= link.label %>"><%= link.label %></a></li>
                <% }) %>
            </div>
            <li class="hamburger mobile-only">
                <a class="hamburger" href="#"><svg class="hamburger" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"><path d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z"/></svg></a>
            </li>
        </ul>

        <ul class="sidebar fabricator-background">
            <% navLinks.forEach(link => { %>
                <li><a class="<%= linkClass(link.href) %>" href="<%= link.href %>" data-text="<%= link.label %>"><%= link.label %></a></li>
            <% }) %>
        </ul>
    </nav>

    <div class="content">

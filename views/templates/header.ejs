<!DOCTYPE html>
<html>

<head>
    <title>3920 Chat Messaging</title>
</head>

<body>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css">
    <div
        style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid black; padding:10px;">

        <div>
            <form action="/" method="get" style="display:inline;">
                <button class="button" type="submit">Home</button>
            </form>
        </div>
        <div class="is-vcentered has-text-centered">
            <% if (loggedIn) { %>

                <!-- <span style="vertical-align: middle;"><b>
                        <%= username %>
                    </b></span> -->

                <form action="/logout" method="get" style="display:inline;">
                    <button class="button" type="submit">Sign Out</button>
                </form>

                <% } else { %>

                    <form action="/login" method="get" style="display:inline;">
                        <button class="button" type="submit">Login</button>
                    </form>

                    <form action="/signup" method="get" style="display:inline;">
                        <button class="button" type="submit">Sign Up</button>
                    </form>

                    <% } %>
        </div>

    </div>
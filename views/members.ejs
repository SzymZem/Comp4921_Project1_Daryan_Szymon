<%- include("templates/header") %>
    <% if (loggedIn) { %>



        <div class="content">
            <h1 class="header">Hello, <%= username %>
            </h1>




            <div class="tabs">
                <ul>
                    <li class="<%= type === 'link' ? 'is-active' : '' %>"><a href="/members?type=link">Links</a></li>
                    <li class="<%= type === 'image' ? 'is-active' : '' %>"><a href="/members?type=image">Images</a></li>
                    <li class="<%= type === 'text' ? 'is-active' : '' %>"><a href="/members?type=text">Text</a></li>
                </ul>
            </div>

            <form class="box" action="/content/create" method="post"
                <% if (type === 'image') { %>enctype="multipart/form-data"<% } %>>
                <input type="hidden" name="type" value="<%= type %>">

                <% if (type === 'link') { %>
                    <div class="field">
                        <label class="label">URL to shorten</label>
                        <div class="control">
                            <input class="input" type="text" name="url" placeholder="https://example.com"
                                value="<%= form.url %>" required>
                        </div>
                    </div>
                <% } else if (type === 'text') { %>
                    <div class="field">
                        <label class="label">Text to share</label>
                        <div class="control">
                            <textarea class="textarea" name="text" maxlength="<%= maxTextLength %>" required><%= form.text %></textarea>
                        </div>
                    </div>
                <% } else { %>
                    <div class="field">
                        <label class="label">Image to share (max 5 MB)</label>
                        <div class="control">
                            <input class="input" type="file" name="image" accept="image/*" required>
                        </div>
                    </div>
                <% } %>

                <div class="field">
                    <label class="label">Custom short URL (optional)</label>
                    <div class="field has-addons">
                        <div class="control">
                            <span class="button is-static"><%= baseUrl %>/</span>
                        </div>
                        <div class="control is-expanded">
                            <input class="input" type="text" name="customCode" placeholder="leave blank for random"
                                value="<%= form.customCode %>" pattern="[A-Za-z0-9_\-]{3,32}">
                        </div>
                    </div>
                    <p class="help">3-32 characters: letters, numbers, - and _</p>
                </div>

                <% if (error) { %>
                    <div class="notification is-danger is-light"><%= error %></div>
                <% } %>

                <button class="button is-primary" type="submit">Create short URL</button>
            </form>

            <% if (contents.length === 0) { %>
                <p>You haven't created any <%= type === 'link' ? 'links' : type === 'image' ? 'images' : 'text' %> yet.</p>
            <% } else { %>
                <table class="table is-fullwidth is-hoverable">
                    <tr>
                        <th>Short URL</th>
                        <th><%= type === 'link' ? 'URL' : type === 'image' ? 'Image' : 'Text' %></th>
                        <th>Hits</th>
                        <th>Active</th>
                        <th>Created</th>
                        <th>Last Hit</th>
                        <th></th>
                    </tr>
                    <% const formatDate = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '-'; %>
                    <% contents.forEach(item => { %>
                        <tr>
                            <td><a href="/<%= item.content_id %>" target="_blank"><%= baseUrl %>/<%= item.content_id %></a></td>
                            <td>
                                <% if (type === 'link') { %>
                                    <a href="<%= item.data %>" target="_blank" rel="noopener noreferrer"><%= item.data %></a>
                                <% } else if (type === 'image') { %>
                                    <img src="<%= imageUrl(item.data, { width: 120, height: 80, crop: 'fill' }) %>" alt="thumbnail">
                                <% } else { %>
                                    <%= item.data.length > 80 ? item.data.slice(0, 80) + '...' : item.data %>
                                <% } %>
                            </td>
                            <td><%= item.hits %></td>
                            <td>
                                <form action="/content/<%= item.content_id %>/toggle" method="post">
                                    <input type="hidden" name="type" value="<%= type %>">
                                    <button class="button is-small <%= item.active ? 'is-success' : 'is-light' %>" type="submit"
                                        title="Click to <%= item.active ? 'disable' : 'enable' %>">
                                        <%= item.active ? 'Active' : 'Disabled' %>
                                    </button>
                                </form>
                            </td>
                            <td><%= formatDate(item.created_datetime) %></td>
                            <td><%= formatDate(item.last_hit_datetime) %></td>
                            <td>
                                <form action="/content/<%= item.content_id %>/delete" method="post"
                                    onsubmit="return confirm('Delete this?');">
                                    <button class="button is-small is-danger is-outlined" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </table>
            <% } %>

        </div>



        <% } else { %>
            <img src="https://media1.tenor.com/m/mVZ8kHeWAdgAAAAd/are-you-still-tdere-hello.gif">
            <% } %>
                <%- include("templates/footer") %>
